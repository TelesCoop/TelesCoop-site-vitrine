---
import Logo from './Logo.astro';

interface Props {
  hideLogo?: boolean;
}

const { hideLogo = false } = Astro.props;

/**
 * `sectionPaths` regroupe les URLs rattachées à une entrée de menu : les pages
 * de détail (`/projet/<slug>`) doivent marquer la rubrique correspondante.
 */
const NAVIGATION_LINKS = [
  { href: '/coopérative', label: 'La coopérative', sectionPaths: ['/coopérative'] },
  { href: '/projets', label: 'Nos projets', sectionPaths: ['/projets', '/projet'] },
  { href: '/blog', label: 'Blog', sectionPaths: ['/blog'] },
];

const currentPath = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '') || '/';

function isCurrentSection(sectionPaths: string[]) {
  return sectionPaths.some(
    (path) => currentPath === path || currentPath.startsWith(`${path}/`)
  );
}
---

<nav id="header" class="sticky top-0 z-50 bg-beige border-b-2 border-black">
  <div class="container mx-auto px-4">
    <div class="flex justify-between">
      <!-- Logo / Brand -->
      <div class={`py-4 ${hideLogo ? 'hidden lg:block' : ''}`}>
        <Logo />
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden min-w-[44px] min-h-[44px] flex items-center justify-center"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="w-6 h-5 flex flex-col justify-between" aria-hidden="true">
          <span class="block h-0.5 w-full bg-black"></span>
          <span class="block h-0.5 w-full bg-black"></span>
          <span class="block h-0.5 w-full bg-black"></span>
        </span>
      </button>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex flex-1 justify-end items-center gap-6" aria-label="Navigation principale">
        {NAVIGATION_LINKS.map(({ href, label, sectionPaths }) => (
          <a
            href={href}
            class="py-2 font-semibold uppercase hover:text-red text-xl aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4"
            aria-current={isCurrentSection(sectionPaths) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a href="mailto:contact@telescoop.fr" class="tag tag-yellow">
          Nous contacter
        </a>
      </nav>
    </div>

    <!-- Mobile Navigation -->
    <nav id="mobile-menu" class="hidden lg:hidden pb-4" aria-label="Navigation principale">
      <div class="flex flex-col gap-3">
        <a href="/" class="py-3 text-center font-semibold uppercase" aria-current={currentPath === '/' ? 'page' : undefined}>Accueil</a>
        {NAVIGATION_LINKS.map(({ href, label, sectionPaths }) => (
          <a
            href={href}
            class="py-3 text-center font-semibold uppercase aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-4"
            aria-current={isCurrentSection(sectionPaths) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a href="mailto:contact@telescoop.fr" class="tag tag-yellow text-center">Nous contacter</a>
      </div>
    </nav>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const header = document.getElementById('header');

    // Mobile menu toggle
    button?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
    });
  });
</script>
