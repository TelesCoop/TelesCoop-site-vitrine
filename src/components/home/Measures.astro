---
interface Measure {
  value: string;
  description: string;
}

interface Props {
  measures: Measure[];
}

const { measures } = Astro.props;
---

<section>
  <div class="container mx-auto px-4">
    <div class="mb-12">
      <span class="tag tag-purple tag-xl">
        Nos mesures d'impact
      </span>
    </div>

    <!-- Liste de définitions : chaque chiffre est la valeur de l'intitulé qui
         le suit, et cette relation doit survivre à une lecture non visuelle. -->
    <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {measures.map((measure, index) => {
        const bgColors = ['bg-orange', 'bg-blue', 'bg-green', 'bg-green', 'bg-yellow'];
        const bgColorClass = bgColors[index % bgColors.length];

        // Map background colors to their corresponding text colors based on CSS variables
        const textColorMap = {
          'bg-orange': 'text-on-orange',
          'bg-blue': 'text-on-blue',
          'bg-green': 'text-on-green',
          'bg-yellow': 'text-on-yellow',
          'bg-purple': 'text-on-purple',
          'bg-pink': 'text-on-pink',
          'bg-beige': 'text-on-beige',
        };

        const textColorVar = textColorMap[bgColorClass] || 'text-on-beige';

        // L'intitulé précède sa valeur dans le DOM, comme l'exige une liste de
        // définitions ; `flex-col-reverse` remet le chiffre au-dessus.
        return (
          <div class={`card flex-col-reverse justify-end p-4 md:p-6 text-center ${index % 2 === 0 ? 'rotate-left' : 'rotate-right'}`}>
            <dt class="text-base md:text-lg lg:text-2xl font-semibold">
              {measure.description}
            </dt>
            <dd
              class={`w-full text-3xl md:text-4xl lg:text-5xl ${bgColorClass} mb-4 font-display rounded-lg px-3 py-2`}
              style={`color: var(--${textColorVar})`}
            >
              {measure.value}
            </dd>
          </div>
        );
      })}
    </dl>
  </div>
</section>
