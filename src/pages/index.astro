---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import About from '../components/home/About.astro';
import Skills from '../components/home/Skills.astro';
import Extra from '../components/home/Extra.astro';
import Measures from '../components/home/Measures.astro';
import Clients from '../components/home/Clients.astro';
import { getEntry, getCollection } from 'astro:content';

const home = await getEntry('data', 'home');
const skills = await getEntry('data', 'skills');
const extra = await getEntry('data', 'extra');
const measures = await getEntry('data', 'measures');

const testimonialsCollection = await getCollection('testimonials', ({ data }) => !data.draft);
const testimonialsData = testimonialsCollection
  .sort((a, b) => a.data.order - b.data.order)
  .map(t => ({
    name: t.data.name,
    client: t.data.client,
    client_poste: t.data.client_poste,
    logo: t.data.logo,
    borderColor: t.data.borderColor,
    testimonial: t.body,
  }));

const homeData = home?.data || {};
const skillsData = skills?.data || [];
const extraData = extra?.data || [];
const measuresData = measures?.data || [];
---

<Layout>
  <Header slot="header" />

  <div>
    <!-- Hero Section -->
    <section class="container mx-auto px-4 py-24 lg:py-32" aria-label="Section d'accueil">
      <h1 class="hero-title leading-[1.04]">
        Coopérative de développement pour des
        <span class="hero-highlight">projets engagés</span>
      </h1>

      <p class="mt-12 text-xl md:text-2xl leading-relaxed max-w-3xl">
        {homeData.tagline}
      </p>

      <div class="mt-10 flex flex-wrap gap-5">
        <a href="/projets" class="btn btn-yellow btn-lg">Voir nos projets</a>
        <a href="mailto:contact@telescoop.fr" class="btn btn-lg">Nous écrire</a>
      </div>
    </section>

    <!-- About Section -->
    <section class="bg-yellow py-16" aria-label="À propos de TelesCoop">
      <About />
    </section>

    <!-- Skills Section -->
    <section class="py-16" aria-label="Notre offre de services">
      <Skills skills={skillsData} />
    </section>

    <!-- Extra Section -->
    <section class="bg-green py-16" aria-label="Notre méthode">
      <Extra extra={extraData} />
    </section>

    <!-- Clients Section -->
    <section class="py-16" aria-label="Témoignages clients">
      <Clients clients={testimonialsData} />
    </section>

    <!-- Measures Section -->
    <section class="bg-yellow py-16" aria-label="Nos mesures d'impact">
      <Measures measures={measuresData} />
    </section>
  </div>

  <Footer slot="footer" />
</Layout>

<style>
  /* Taille fluide plutôt que par paliers : le titre doit remplir le rail à
     toutes les largeurs. Le plafond est calé sur « développement », le mot le
     plus long — au-delà, il force une coupe précoce et le pavé se creuse.
     L'équilibrage automatique des lignes est écarté pour la même raison : il
     égalise leur longueur, donc les raccourcit. */
  .hero-title {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
  }

  /* Surlignage du titre : un trait passé derrière les mots plutôt qu'un pavé
     qui les inverse. Le texte reste noir — donc pleinement lisible — et le
     geste est celui d'un marqueur, ce que le sens appelle. Un pavé bordé et
     ombré, lui, ferait doublon avec les boutons placés juste en dessous.

     Les mesures sont en `em` pour suivre la taille fluide du titre. */
  .hero-title {
    position: relative;
    z-index: 0;
  }

  .hero-highlight {
    position: relative;
    padding: 0 0.1em;
  }

  .hero-highlight::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 0;
    right: 0;
    /* Calé sur la ligne de base, pas sur le bas de la boîte inline : celle-ci
       inclut les jambages et le demi-interligne, ce qui ferait flotter le
       trait sous le texte. */
    bottom: 0.32em;
    height: 0.42em;
    /* Vert plutôt que jaune : le jaune porte déjà le bouton principal, et le
       vert renvoie à la transition écologique dont parle le titre. */
    background: var(--color-green);
    /* Le trait se pose de gauche à droite au chargement : seule animation de
       la section, elle n'occupe que la première demi-seconde. */
    animation: hero-highlight-sweep 460ms cubic-bezier(0.22, 0.61, 0.36, 1) 160ms both;
  }

  @keyframes hero-highlight-sweep {
    from {
      transform: scaleX(0);
      transform-origin: left center;
    }
    to {
      transform: scaleX(1);
      transform-origin: left center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-highlight::before {
      animation: none;
    }
  }
</style>
