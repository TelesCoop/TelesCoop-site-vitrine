---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { getImageDimensions } from '../../utils/images';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { data, body } = project;
const { Content } = await render(project);
const categories = await getEntry('data', 'categories');
const categoriesData = categories?.data || {};

function getCategoryColorClass(categoryName: string) {
  const category = categoriesData[categoryName];
  return category?.colorClass || 'beige';
}

const thumbnailDimensions = data.projectThumbnail
  ? await getImageDimensions(data.projectThumbnail)
  : null;
---

<Layout title={data.title} description={data.projectResume}>
  <Header slot="header" />

  <article>
    <!-- Hero Section -->
    <div class="container mx-auto px-4 py-12">
      <div>
        <!-- Back link -->
        <a href="/projets" class="inline-flex items-center gap-2 mb-8 text-xl hover:text-orange">
          <span>←</span>
          <span>Retour aux projets</span>
        </a>

        <!-- Title & Categories -->
        <div class="mb-8">
          <h1 class="page-title mb-6">{data.title}</h1>

          {data.categories && data.categories.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {data.categories.map((cat: string) => (
                <span class="badge" data-color={getCategoryColorClass(cat)}>
                  {categoriesData[cat]?.name || cat}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Project Image -->
        {data.projectThumbnail && thumbnailDimensions && (
          <div class="relative">
            <img
              src={data.projectThumbnail}
              alt={data.projectThumbnailAlt || data.title}
              class="w-full h-auto rounded-[10px] border-2 border-black"
              width={thumbnailDimensions.width}
              height={thumbnailDimensions.height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>

    <!-- Content Section -->
    <div class="py-16">
      <div class="container mx-auto px-4">
        <!-- Grille 12 colonnes : la colonne de lecture est bornée à 7/12 pour
             garder une longueur de ligne confortable sur grand écran. -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <!-- Main Content -->
          <div class="lg:col-span-7 space-y-16">
            <!-- Resume -->
            <div>
              <h2 class="section-title mb-6 pb-4 border-b-2 border-black">Le projet</h2>
              <p class="text-2xl text-black leading-relaxed mt-6">{data.projectResume}</p>
            </div>

            <!-- Description -->
            {body && (
              <div>
                <h2 class="section-title mb-6 pb-4 border-b-2 border-black">Description</h2>
                <div class="rich-text mt-6">
                  <Content />
                </div>
              </div>
            )}

            <!-- Testimony -->
            {data.testimony && (
              <div class="bg-white p-10 rounded-[10px] border-2 border-black relative" style="filter: drop-shadow(8px 8px 0 var(--palette-border));">
                <div class="text-8xl mb-4 leading-none text-purple absolute top-0 left-6">"</div>
                <p class="text-2xl text-black leading-relaxed italic mb-6 mt-8">{data.testimony}</p>
                {data.clientName && (
                  <p class="text-xl font-semibold text-black">— {data.clientName}</p>
                )}
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-4 lg:col-start-9 space-y-8">
            <!-- Client Info -->
            {data.clientName && (
              <div>
                <h3 class="subsection-title mb-4">Client</h3>
                <p class="text-black text-xl font-semibold">{data.clientName}</p>
                {data.clientDescription && (
                  <p class="text-lg text-black mt-3 leading-relaxed">{data.clientDescription}</p>
                )}
              </div>
            )}

            <!-- Project Info -->
            <div class="space-y-6">
              <div>
                <h3 class="meta-label mb-2">Statut</h3>
                <p class="text-black text-xl font-semibold">
                  {data.projectEnd ? 'Terminé' : 'En cours'}
                </p>
              </div>

              {data.projectDuration && (
                <div>
                  <h3 class="meta-label mb-2">Durée</h3>
                  <p class="text-black text-xl font-semibold">
                    {data.projectDuration} {data.projectDurationUnit || ''}
                  </p>
                </div>
              )}

              {data.projectEnd && (
                <div>
                  <h3 class="meta-label mb-2">Date de fin</h3>
                  <p class="text-black text-xl font-semibold">{data.projectEnd}</p>
                </div>
              )}
            </div>

            <!-- Technologies -->
            {data.projectStack && data.projectStack.length > 0 && (
              <div>
                <h3 class="subsection-title mb-4">Technologies</h3>
                <div class="flex flex-wrap gap-2">
                  {data.projectStack.map((tech: string) => (
                    <span class="badge">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <!-- Links -->
            {(data.projectLink || data.projectGit) && (
              <div class="space-y-3 pt-4">
                {data.projectLink && (
                  <a
                    href={data.projectLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-orange block text-center"
                  >
                    Voir le projet →
                  </a>
                )}
                {data.projectGit && (
                  <a
                    href={data.projectGit}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn block text-center"
                  >
                    Code source
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </article>

  <Footer slot="footer" />
</Layout>
