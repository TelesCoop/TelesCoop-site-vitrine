---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const data404 = await getEntry('data', '404');
const title = data404?.data?.title || 'Page introuvable';
---

<Layout title={title} noindex>
  <section class="min-h-screen flex items-center justify-center bg-primary">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-6xl font-light text-white mb-6">
        {title}
      </h1>
      <h2 class="text-xl md:text-2xl text-white">
        Recadrez votre Telescoop,{' '}
        <a href="/" class="underline hover:text-blue transition-colors">
          Retourner sur l'accueil
        </a>
      </h2>
    </div>
  </section>
</Layout>
